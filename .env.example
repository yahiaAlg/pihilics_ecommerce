# Copy to .env (and load it however your process manager prefers -- this
# project doesn't depend on python-dotenv) or export these directly.
# None are required for local development; settings.py falls back to
# insecure-but-workable defaults (DEBUG=True, SQLite, an obviously-fake
# SECRET_KEY) when they're unset.

# --- Core -------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-value-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# --- Database -----------------------------------------------------------
# Omit DJANGO_DB_ENGINE entirely to use SQLite (the local-dev default).
DJANGO_DB_ENGINE=postgresql
DJANGO_DB_NAME=arko
DJANGO_DB_USER=arko
DJANGO_DB_PASSWORD=change-me
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# --- Email (core.emails) -------------------------------------------------
# Omit EMAIL_HOST_PASSWORD entirely to use the console backend (the
# local-dev default) -- mail is then just printed to stdout, no live SMTP
# server required.
EMAIL_HOST=mail.pihilics-product.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=commercial@pihilics-product.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Pihilics <commercial@pihilics-product.com>
ADMIN_NOTIFICATION_EMAIL=admin@pihilics-product.com

# --- Site URL (absolute links in outgoing emails) ------------------------
SITE_URL=https://pihilics.dz

# --- Chargily Pay (orders.chargily) -- CIB/Edahabia card checkout --------
# Omit both keys entirely to leave CIB/Edahabia effectively disabled (the
# local-dev default) -- checkout creation fails cleanly with ChargilyError
# and the customer sees a "Complete Payment" retry button rather than a
# 500. Get test_* keys from Developers Corner in the Chargily dashboard;
# swap the URL and both keys to their live_* equivalents only after both
# your User Account and Application are separately verified there.
CHARGILY_KEY=test_pk_xxxxxxxxxxxxxxxxxxxxxxxx
CHARGILY_SECRET=test_sk_xxxxxxxxxxxxxxxxxxxxxxxx
CHARGILY_API_URL=https://pay.chargily.net/test/api/v2/
