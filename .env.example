# Local/deployment environment overrides. Copy this file to `.env` and fill
# in real values -- `.env` is gitignored and loaded automatically via
# python-dotenv in config/settings.py.

# --- Core (config.settings) ------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,www.pihilics-product.com,pihilics-product.com

# --- Database (config.settings) --------------------------------------------
# Leave DJANGO_DB_ENGINE unset (or blank) to use SQLite for local dev.
# Set DJANGO_DB_ENGINE=mysql to use MySQL/MariaDB instead (requires the
# mysqlclient package from requirements.txt).
DJANGO_DB_ENGINE=mysql
DJANGO_DB_NAME=gytuxwxs_pihilics
DJANGO_DB_USER=gytuxwxs_pihilics
DJANGO_DB_PASSWORD=Alaa1234567890@
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=3306

# --- Email (core.emails) ----------------------------------------------------
# SSL/TLS settings from your mailbox provider.
EMAIL_HOST=mail.pihilics-product.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=commercial@pihilics-product.com
EMAIL_HOST_PASSWORD=system2026*
DEFAULT_FROM_EMAIL=Pihilics <commercial@pihilics-product.com>
ADMIN_NOTIFICATION_EMAIL=admin@pihilics-product.com

# --- Site URL (absolute links in outgoing emails) ---------------------------
SITE_URL=https://pihilics.dz

# --- Chargily Pay (orders.chargily) -- CIB/Edahabia card checkout ----------
# Leave blank for test/dev; CIB orders fall back to the "Complete Payment"
# retry button instead of erroring. Fill in the live_* keys and switch
# CHARGILY_API_URL to the live URL (no /test/) only once approved.
CHARGILY_KEY=
CHARGILY_SECRET=
CHARGILY_API_URL=https://pay.chargily.net/test/api/v2/
